OPENAI_API_KEY=
STORAGE_PATH=./output

# Plain Rust signaling (streamer + WSS proxy upstream).
AURA_BIND_IP=127.0.0.1
AURA_SIGNALING_HOST=127.0.0.1
AURA_SIGNALING_PORT=3030
AURA_IVF_DIR=./ivf_files

# Browser-facing WSS proxy port (use in ?signaling=host:3031 with HTTPS UI).
AURA_WSS_PROXY_PORT=3031
# AURA_TLS_DIR=

AURA_GPU_HOST=

AURA_EMOTION_EMBED_DIM=2048
AURA_CLIP_PROJECTION_DIM=128

OPENAI_API_KEY=
STORAGE_PATH=./output

# WebRTC host settings. On a cloud/GPU host bind 0.0.0.0 and point clients at
# that machine's reachable IP or hostname.
AURA_BIND_IP=0.0.0.0
AURA_SIGNALING_HOST=127.0.0.1
AURA_SIGNALING_PORT=3030
AURA_IVF_DIR=./ivf_files

# Optional: LAN/Windows GPU machine hostname or IP when not using this host.
AURA_GPU_HOST=

AURA_EMOTION_EMBED_DIM=2048
AURA_CLIP_PROJECTION_DIM=128
